---
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import MonogramLogo from '../components/MonogramLogo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  seo?: SEOProps;
  title?: string;
  description?: string;
  activeNav?: 'home' | 'blog' | 'about' | 'contact';
}

const { seo, title, description, activeNav = 'home' } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'হোম', href: '/', id: 'home', icon: 'home' },
  { label: 'ব্লগ', href: '/blog', id: 'blog', icon: 'article' },
  { label: 'আমার সম্পর্কে', href: '/about', id: 'about', icon: 'person' },
  { label: 'যোগাযোগ', href: '/contact', id: 'contact', icon: 'mail' },
];

const isItemActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<!DOCTYPE html>
<html lang="bn" class="scroll-smooth overflow-x-hidden max-w-full">
  <head>
    <!-- Inline Theme Script to Prevent Flash of Wrong Theme (FOUC) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>

    {seo ? <SEO {...seo} /> : <SEO title={title} description={description} />}
  </head>
  <body class="bg-surface dark:bg-dark-bg text-on-surface dark:text-dark-text min-h-screen flex flex-col font-body transition-colors duration-300 antialiased selection:bg-gold selection:text-ink overflow-x-hidden max-w-full">
    
    <!-- DESKTOP STICKY IDENTITY RAIL (Left column, fixed 280px) -->
    <aside class="fixed left-0 top-0 h-screen w-identity-rail-width border-r border-outline/20 dark:border-dark-border bg-surface dark:bg-dark-rail hidden lg:flex flex-col p-8 z-40 justify-between select-none">
      <!-- Identity / Brand Header -->
      <div class="space-y-6">
        <a href="/" class="group block" aria-label="হোমপেজে যান">
          <MonogramLogo className="w-16 h-16 transition-transform duration-300 group-hover:scale-105" />
          <div class="mt-4">
            <h1 class="font-tiro text-3xl font-bold text-ink dark:text-gold tracking-tight group-hover:text-secondary dark:group-hover:text-paper transition-colors">
              ইয়াহিয়া
            </h1>
            <p class="font-body text-sm text-slate dark:text-dark-muted mt-1 leading-relaxed">
              প্রযুক্তি ও জীবনবোধের কথকতা
            </p>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="flex flex-col gap-4 pt-6" aria-label="প্রধান নেভিগেশন">
          {navItems.map((item) => {
            const active = isItemActive(item.href);
            return (
              <a
                href={item.href}
                class={`flex items-center gap-3.5 px-3 py-2.5 text-sm font-semibold tracking-wide transition-all duration-200 rounded ${
                  active
                    ? 'text-primary dark:text-gold font-bold border-b-2 border-primary dark:border-gold bg-primary/5 dark:bg-gold/10'
                    : 'text-slate dark:text-dark-muted hover:text-secondary dark:hover:text-gold hover:translate-x-1'
                }`}
              >
                <!-- SVG Icon for each item -->
                {item.icon === 'home' && (
                  <svg class="w-5 h-5 opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                )}
                {item.icon === 'article' && (
                  <svg class="w-5 h-5 opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                )}
                {item.icon === 'person' && (
                  <svg class="w-5 h-5 opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                )}
                {item.icon === 'mail' && (
                  <svg class="w-5 h-5 opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Identity Rail Bottom Controls -->
      <div class="space-y-6 pt-6 border-t border-outline/20 dark:border-dark-border">
        <!-- Theme Toggle Switcher -->
        <div>
          <ThemeToggle />
        </div>

        <!-- Social Channels & RSS -->
        <div class="flex items-center gap-4 text-slate dark:text-dark-muted">
          <a
            href="https://github.com/UserYahya"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-secondary dark:hover:text-gold transition-colors p-1"
            aria-label="গিটহাব প্রোফাইল"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-secondary dark:hover:text-gold transition-colors p-1"
            aria-label="লিঙ্কডইন প্রোফাইল"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25a1.66 1.66 0 0 0-1.66 1.66c0 .92.74 1.66 1.66 1.66.92 0 1.66-.74 1.66-1.66 0-.92-.74-1.66-1.66-1.66Z" />
            </svg>
          </a>
          <a
            href="/rss.xml"
            class="hover:text-secondary dark:hover:text-gold transition-colors p-1"
            aria-label="আরএসএস ফিড"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z" />
            </svg>
          </a>
        </div>
      </div>
    </aside>

    <!-- MOBILE TOP APP BAR (Fixed top on small screens < 1024px) -->
    <header class="flex lg:hidden justify-between items-center px-4 sm:px-6 h-16 w-full z-50 fixed top-0 left-0 bg-surface/95 dark:bg-dark-surface/95 backdrop-blur border-b-2 border-primary dark:border-gold">
      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="মেনু খুলুন বা বন্ধ করুন"
        aria-expanded="false"
        class="text-ink dark:text-dark-text p-2 -ml-2 rounded hover:text-secondary dark:hover:text-gold transition-colors focus:outline-none focus:ring-2 focus:ring-gold"
      >
        <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Site Brand Name -->
      <a href="/" class="font-tiro text-2xl font-bold text-ink dark:text-gold tracking-tight">
        ইয়াহিয়া
      </a>

      <!-- Quick Theme Toggle on Mobile -->
      <div class="flex items-center">
        <ThemeToggle showText={false} />
      </div>
    </header>

    <!-- MOBILE NAVIGATION DRAWER -->
    <div
      id="mobile-drawer"
      class="fixed inset-0 top-16 z-40 bg-surface/98 dark:bg-dark-rail/98 backdrop-blur transition-all duration-300 lg:hidden hidden flex-col justify-between p-6 sm:p-8"
      aria-hidden="true"
    >
      <nav class="flex flex-col gap-5 pt-4">
        {navItems.map((item) => {
          const active = isItemActive(item.href);
          return (
            <a
              href={item.href}
              class={`flex items-center justify-between text-xl font-tiro py-3 border-b border-outline/15 dark:border-dark-border transition-colors ${
                active
                  ? 'text-primary dark:text-gold font-bold'
                  : 'text-ink dark:text-dark-text hover:text-secondary dark:hover:text-gold'
              }`}
            >
              <span>{item.label}</span>
              <svg class="w-5 h-5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          );
        })}
      </nav>

      <div class="space-y-6 pt-6 border-t border-outline/20 dark:border-dark-border">
        <div class="flex justify-between items-center">
          <span class="text-sm font-semibold text-slate dark:text-dark-muted">থিম মুড:</span>
          <ThemeToggle />
        </div>
        <div class="flex justify-center gap-6 pt-2 text-slate dark:text-dark-muted">
          <a href="https://github.com/UserYahya" target="_blank" rel="noopener noreferrer" class="hover:text-secondary dark:hover:text-gold p-2" aria-label="গিটহাব">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-secondary dark:hover:text-gold p-2" aria-label="লিঙ্কডইন">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25a1.66 1.66 0 0 0-1.66 1.66c0 .92.74 1.66 1.66 1.66.92 0 1.66-.74 1.66-1.66 0-.92-.74-1.66-1.66-1.66Z"/></svg>
          </a>
          <a href="/rss.xml" class="hover:text-secondary dark:hover:text-gold p-2" aria-label="আরএসএস">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- MAIN SCROLLABLE CONTENT COLUMN (Precisely sized for desktop to eliminate horizontal scroll) -->
    <main class="w-full lg:w-[calc(100%-280px)] lg:ml-[280px] min-h-screen pt-16 lg:pt-0 flex flex-col justify-between overflow-x-hidden min-w-0">
      <div class="max-w-content-max-width w-full mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-12 lg:py-16">
        <slot />
      </div>

      <!-- Semantic Bengali Footer -->
      <footer class="w-full py-10 border-t border-outline/15 dark:border-dark-border mt-16 bg-surface-container/40 dark:bg-dark-surface/40">
        <div class="max-w-content-max-width mx-auto px-4 sm:px-8 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-semibold text-slate dark:text-dark-muted">
          <p>© ২০২৪ মুহাম্মদ ইয়াহিয়া। সর্বস্বত্ব সংরক্ষিত।</p>
          <div class="flex items-center gap-6">
            <a href="/about" class="hover:text-primary dark:hover:text-gold transition-colors">আমার সম্পর্কে</a>
            <a href="/blog" class="hover:text-primary dark:hover:text-gold transition-colors">ব্লগ আর্কাইভ</a>
            <a href="/contact" class="hover:text-primary dark:hover:text-gold transition-colors">যোগাযোগ</a>
            <a href="/rss.xml" class="hover:text-primary dark:hover:text-gold transition-colors">আরএসএস</a>
          </div>
        </div>
      </footer>
    </main>

    <!-- Mobile Menu Script -->
    <script>
      function setupMobileMenu() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const drawer = document.getElementById('mobile-drawer');
        const openIcon = document.getElementById('menu-icon-open');
        const closeIcon = document.getElementById('menu-icon-close');

        if (!toggleBtn || !drawer || !openIcon || !closeIcon) return;

        toggleBtn.addEventListener('click', () => {
          const isHidden = drawer.classList.contains('hidden');
          if (isHidden) {
            drawer.classList.remove('hidden');
            drawer.classList.add('flex');
            openIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
            toggleBtn.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
          } else {
            drawer.classList.add('hidden');
            drawer.classList.remove('flex');
            openIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
            toggleBtn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
          }
        });
      }

      setupMobileMenu();
      document.addEventListener('astro:after-swap', setupMobileMenu);
    </script>
  </body>
</html>
