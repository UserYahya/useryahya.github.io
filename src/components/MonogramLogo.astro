---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-16 h-16", size = 64 } = Astro.props;
---

<div class={`inline-flex items-center justify-center relative font-tiro select-none ${className}`} aria-label="ইয়াহিয়া লোগো">
  <svg
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full text-ink dark:text-gold transition-colors duration-300"
  >
    <!-- Tactile brush stamp background circle/shield -->
    <rect
      x="8"
      y="8"
      width="84"
      height="84"
      rx="6"
      stroke="currentColor"
      stroke-width="3"
      stroke-opacity="0.25"
      class="dark:stroke-gold/40"
    />
    <rect
      x="12"
      y="12"
      width="76"
      height="76"
      rx="4"
      fill="currentColor"
      fill-opacity="0.04"
      class="dark:fill-gold/10"
    />
    <!-- Calligraphic Bengali Letter 'য' / Yahya Monogram -->
    <path
      d="M28 32 C38 31, 62 31, 72 32 M50 32 L50 68 C50 74, 46 76, 38 76 C32 76, 28 72, 28 66 C28 58, 38 52, 48 52 C58 52, 68 58, 68 68 C68 76, 62 78, 52 78"
      stroke="currentColor"
      stroke-width="5.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-ink dark:stroke-gold"
    />
    <!-- Ink Accent Dot / Stamp -->
    <circle
      cx="70"
      cy="34"
      r="3.5"
      fill="#7C2D3B"
      class="dark:fill-gold"
    />
  </svg>
</div>
