---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-16 h-16", size = 64 } = Astro.props;
---

<div class={`inline-flex items-center justify-center relative font-tiro select-none ${className}`} aria-label="ইয়াহিয়া লোগো">
  <svg
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full text-ink dark:text-gold transition-colors duration-300"
  >
    <!-- Tactile brush stamp background frame -->
    <rect
      x="8"
      y="8"
      width="84"
      height="84"
      rx="6"
      stroke="currentColor"
      stroke-width="3"
      stroke-opacity="0.25"
      class="dark:stroke-gold/40"
    />
    <rect
      x="12"
      y="12"
      width="76"
      height="76"
      rx="4"
      fill="currentColor"
      fill-opacity="0.04"
      class="dark:fill-gold/10"
    />

    <!-- English Letter 'Y' Monogram for Yahya -->
    <path
      d="M28 26 L50 54 L72 26 M50 54 L50 76"
      stroke="currentColor"
      stroke-width="6.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-ink dark:stroke-gold"
    />

    <!-- Ink Accent Dot / Stamp -->
    <circle
      cx="74"
      cy="74"
      r="3.5"
      fill="#7C2D3B"
      class="dark:fill-gold"
    />
  </svg>
</div>
