---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-16 h-16", size = 64 } = Astro.props;
---

<div class={`inline-flex items-center justify-center relative font-tiro select-none ${className}`} aria-label="ইয়াহিয়া লোগো">
  <svg
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full text-ink dark:text-gold transition-colors duration-300"
  >
    <!-- Tactile brush stamp background frame -->
    <rect
      x="8"
      y="8"
      width="84"
      height="84"
      rx="6"
      stroke="currentColor"
      stroke-width="3"
      stroke-opacity="0.25"
      class="dark:stroke-gold/40"
    />
    <rect
      x="12"
      y="12"
      width="76"
      height="76"
      rx="4"
      fill="currentColor"
      fill-opacity="0.04"
      class="dark:fill-gold/10"
    />

    <!-- Bengali Letter 'ই' Monogram (Bangla 'I' for 'ইয়াহিয়া') -->
    <!-- 1. Top Flying Tail / উড়নি -->
    <path
      d="M48 26 C52 14, 66 12, 74 19 C78 23, 76 27, 72 26"
      stroke="currentColor"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-ink dark:stroke-gold"
    />

    <!-- 2. Top Matra (মাত্রা) -->
    <path
      d="M24 28 L76 28"
      stroke="currentColor"
      stroke-width="5"
      stroke-linecap="round"
      class="stroke-ink dark:stroke-gold"
    />

    <!-- 3. Main Calligraphic Body of 'ই' -->
    <path
      d="M33 28 C26 34, 26 44, 34 46 C42 48, 56 42, 60 52 C64 62, 54 74, 42 74 C34 74, 30 68, 32 62 C34 56, 42 56, 42 62"
      stroke="currentColor"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-ink dark:stroke-gold"
    />

    <!-- Ink Accent Dot / Stamp -->
    <circle
      cx="74"
      cy="70"
      r="3.5"
      fill="#7C2D3B"
      class="dark:fill-gold"
    />
  </svg>
</div>
