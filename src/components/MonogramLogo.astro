---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-16 h-16", size = 64 } = Astro.props;
---

<div class={`inline-flex items-center justify-center relative select-none ${className}`} role="img" aria-label="ইয়াহিয়া লোগো">
  <svg
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full text-ink dark:text-gold transition-colors duration-300"
    aria-hidden="true"
  >
    <!-- Tactile brush stamp background frame -->
    <rect
      x="8"
      y="8"
      width="84"
      height="84"
      rx="6"
      stroke="currentColor"
      stroke-width="3"
      stroke-opacity="0.25"
      class="dark:stroke-gold/40"
    />
    <rect
      x="12"
      y="12"
      width="76"
      height="76"
      rx="4"
      fill="currentColor"
      fill-opacity="0.04"
      class="dark:fill-gold/10"
    />

    <!-- Bangla letter 'ই' for ইয়াহিয়া — outline drawn from the site's Tiro Bangla typeface -->
    <path
      d="M68.81 80H68.4Q63.34 75.94 58.8 73.2Q54.27 70.46 49.76 68.64Q45.26 66.81 40.2 65.69L36.02 57.92L36.31 57.63Q39.78 59.1 41.64 59.6Q43.49 60.1 45.14 60.1Q47.2 60.1 49.53 59.42Q51.85 58.74 53.89 57.54Q55.92 56.33 57.18 54.71Q58.45 53.09 58.45 51.21Q58.45 49.15 56.95 48.12Q55.45 47.09 53.56 47.09Q52.74 47.09 51.97 47.29Q51.21 47.5 50.56 47.79Q50.15 50.91 48.12 52.59Q46.08 54.27 43.38 54.27Q41.2 54.27 39.7 53.12Q38.19 51.97 38.19 49.91Q38.19 48.03 39.52 46.64Q40.84 45.26 42.96 44.44Q45.08 43.61 47.44 43.38Q47.32 42.55 46.91 41.76Q46.5 40.96 45.79 40.26H34.72L31.19 36.72V36.25H56.57Q57.39 35.19 57.39 34.19Q57.39 33.01 55.98 32.16Q54.56 31.31 51.74 31.31Q50.56 31.31 48.85 31.45Q47.14 31.6 45.38 31.75Q43.61 31.89 42.2 31.89Q36.72 31.89 34.01 29.63Q31.31 27.36 31.31 24.42Q31.31 23.36 31.69 22.18Q32.07 21 32.95 20H33.42L34.84 21.18Q34.31 21.94 34.1 22.62Q33.9 23.3 33.9 23.89Q33.9 25.59 35.37 26.33Q36.84 27.07 39.96 27.07Q42.26 27.07 44.82 26.8Q47.38 26.54 49.09 26.54Q52.86 26.54 55.24 27.83Q57.63 29.13 58.83 31.33Q60.04 33.54 60.22 36.25H62.34L65.87 39.78V40.26H49.79Q50.26 41.49 50.5 43.32Q53.15 43.49 55.83 44.58Q58.51 45.67 60.27 47.82Q62.04 49.97 62.04 53.33Q62.04 57.68 58.92 60.36Q55.8 63.04 50.97 64.4V64.57Q56.15 67.4 59.51 69.75Q62.87 72.11 64.84 73.96Q66.81 75.82 67.99 77.17Z"
      fill="currentColor"
      class="fill-ink dark:fill-gold"
    />

    <!-- Ink Accent Dot / Stamp -->
    <circle
      cx="77"
      cy="77"
      r="3.5"
      fill="#7C2D3B"
      class="dark:fill-gold"
    />
  </svg>
</div>
