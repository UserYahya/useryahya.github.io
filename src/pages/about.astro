---
import BaseLayout from '../layouts/BaseLayout.astro';

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Yahya",
  "alternateName": "মুহাম্মদ ইয়াহিয়া",
  "url": "https://yahya.bd/about",
  "image": "https://yahya.bd/images/yahya.png",
  "jobTitle": "Development Professional & Wikimedia Steward",
  "nationality": "Bangladeshi",
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
      "name": "Bangladesh University of Engineering and Technology (BUET)"
    }
  ],
  "description": "মুহাম্মদ ইয়াহিয়া একজন ডেভেলপমেন্ট প্রফেশনাল, উইকিমিডিয়া স্টুয়ার্ড এবং উন্মুক্ত জ্ঞান গবেষক। প্রযুক্তি, ডেটা পলিসি ও কমিউনিটি গভর্নেন্স নিয়ে কাজ করেন।",
  "sameAs": [
    "https://meta.wikimedia.org/wiki/User:Yahya",
    "https://github.com/UserYahya"
  ],
  "knowsAbout": [
    "Open Knowledge",
    "Wikimedia Governance",
    "Trust and Safety",
    "Mathematics",
    "Community Organizing",
    "Wikidata & Structured Data",
    "Digital Policy"
  ]
};

const timeline = [
  {
    period: "২০২৫ — বর্তমান",
    title: "উইকিমিডিয়া স্টুয়ার্ড ও গ্লোবাল গভর্নেন্স",
    description: "বিশ্বব্যাপী উন্মুক্ত জ্ঞান ইকোসিস্টেমের গ্লোবাল ট্রাস্ট অ্যান্ড সেফটি অপারেশন, সংবেদনশীল পারমিশন হ্যান্ডলিং এবং প্ল্যাটফর্ম ইন্টিগ্রিটি নিশ্চিতকরণের দায়িত্ব। কেনিয়ার নাইরোবিতে অনুষ্ঠিত উইকিম্যানিয়া ২০২৫ এবং ইতালির মিলানে উইকিমিডিয়া হ্যাকাথন ২০২৬ এর পূর্ণ স্কলারশিপ প্রাপক।"
  },
  {
    period: "২০২৩ — ২০২৪",
    title: "প্রধান সমন্বয়ক ও প্রকল্প প্রশাসক",
    description: "ঢাকা উইকিমিডিয়া কমিউনিটির চিফ কোঅর্ডিনেটর হিসেবে স্থানীয় ভলান্টিয়ার কমিউনিটি পরিচালনা; উইকিপিডিয়া, উইকিউপাত্ত (Wikidata) ও উইকিভ্রমণ (Wikivoyage) প্রশাসক; এবং উইকি লাভস আর্থ ২০২৫ আন্তর্জাতিক সমন্বয়কের দায়িত্ব পালন।"
  },
  {
    period: "শিক্ষা ও প্রাতিষ্ঠানিক ভিত্তি",
    title: "বুয়েট (BUET) ও গণিত অনুষদ",
    description: "বাংলাদেশ প্রকৌশল বিশ্ববিদ্যালয় (BUET) থেকে পোস্ট গ্র্যাজুয়েট ডিপ্লোমা ইন বিজনেস আইটি এবং গণিতে স্নাতক ডিগ্রি অর্জন। গাণিতিক বিশ্লেষণ এবং ডেটা-ড্রিভেন সিদ্ধান্তের মেলবন্ধনে কমিউনিটি উন্নয়ন।"
  }
];

const topics = [
  "উইকিমিডিয়া স্টুয়ার্ড",
  "উন্মুক্ত জ্ঞান (Open Knowledge)",
  "স্ট্রাকচার্ড ডেটা (Wikidata)",
  "ডিজিটাল পলিসি ও গভর্নেন্স",
  "গণিত (Mathematics)",
  "ওপেনস্ট্রিটম্যাপ (OpenStreetMap)",
  "বিজনেস আইটি ও অ্যানালিটিক্স",
  "কমিউনিটি লিডারশিপ"
];
---

<BaseLayout
  title="আমার সম্পর্কে"
  description="মুহাম্মদ ইয়াহিয়ার পরিচিতি, অভিজ্ঞতা ও কর্মজীবন। ডেভেলপমেন্ট প্রফেশনাল, উইকিমিডিয়া স্টুয়ার্ড এবং উন্মুক্ত জ্ঞান গবেষক।"
  activeNav="about"
  seo={{
    title: "আমার সম্পর্কে",
    description: "মুহাম্মদ ইয়াহিয়ার পরিচিতি, অভিজ্ঞতা ও কর্মজীবন।",
    image: "/images/yahya.png",
    type: "profile",
    jsonLd: personJsonLd
  }}
>
  <div class="space-y-16 sm:space-y-20">
    <!-- 1. HERO BIO SECTION -->
    <section class="flex flex-col-reverse lg:flex-row gap-10 lg:gap-14 items-start">
      <!-- Bio Text -->
      <div class="flex-1 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-gold/15 dark:bg-gold/10 border border-gold/40 text-xs font-semibold text-secondary dark:text-gold uppercase tracking-widest">
          জীবন ও কর্ম
        </div>

        <h2 class="font-tiro text-3xl sm:text-4xl font-bold text-ink dark:text-dark-text leading-tight">
          আমার সম্পর্কে
        </h2>

        <div class="font-body text-base sm:text-lg text-slate dark:text-dark-muted space-y-4 leading-relaxed">
          <p>
            আমি <strong class="text-ink dark:text-gold font-semibold">মুহাম্মদ ইয়াহিয়া</strong>। একজন ডেভেলপমেন্ট প্রফেশনাল, উইকিমিডিয়া স্টুয়ার্ড এবং উন্মুক্ত জ্ঞান গবেষক। প্রযুক্তি, নীতিমালা (Policy) এবং তৃণমূল কমিউনিটির সংযোগস্থলে কাজ করাই আমার মূল ক্ষেত্র।
          </p>
          <p>
            গণিত ও তথ্যপ্রযুক্তির প্রাতিষ্ঠানিক ভিত্তি থেকে আমি যেকোনো জটিল কমিউনিটি চ্যালেঞ্জে অ্যানালিটিক্যাল নির্ভুলতা এবং মানবিক নেতৃত্বের সমন্বয় ঘটাই। বৈশ্বিক উন্মুক্ত জ্ঞান আন্দোলনে স্বল্প-প্রতিনিধিত্বশীল ভাষা সম্প্রদায়গুলোকে শক্তিশালী করা এবং মুক্ত বিশ্বকোষের ট্রাস্ট ও সেফটি নিশ্চিতে আমি নিরলসভাবে কাজ করে যাচ্ছি।
          </p>

          <blockquote class="pl-6 border-l-4 border-maroon dark:border-gold font-tiro text-lg sm:text-xl italic text-ink dark:text-gold my-6 py-1 bg-gold/5 dark:bg-gold/5">
            "প্রযুক্তি, ডিজিটাল নীতিমালা ও তৃণমূল মানুষের স্বতঃস্ফূর্ত অংশগ্রহণের মেলবন্ধনেই উন্মুক্ত জ্ঞানের স্থায়ী ভবিষ্যৎ রচিত হয়।"
          </blockquote>

          <p>
            উইকিমিডিয়া স্টুয়ার্ড হিসেবে বৈশ্বিক প্রকল্পের নিরাপত্তা ও নীতি নির্ধারণের পাশাপাশি স্থানীয় পর্যায়ে নতুন স্বেচ্ছাসেবক তৈরি ও প্রশিক্ষণ প্রদানে আমি নিবেদিত।
          </p>
        </div>

        <!-- Action CTAs -->
        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3 bg-gold hover:bg-maroon text-ink hover:text-paper dark:text-ink dark:hover:text-paper font-semibold text-xs sm:text-sm uppercase tracking-wider transition-colors duration-300 rounded-none shadow-sm"
          >
            যোগাযোগ করুন
          </a>
          <a
            href="https://meta.wikimedia.org/wiki/User:Yahya"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3 border-2 border-outline/40 dark:border-dark-border text-ink dark:text-dark-text hover:border-gold hover:text-secondary dark:hover:text-gold font-semibold text-xs sm:text-sm uppercase tracking-wider transition-colors duration-300 rounded-none"
          >
            উইকিমিডিয়া প্রোফাইল &rarr;
          </a>
        </div>
      </div>

      <!-- Tactile Photo Frame with Real Photo -->
      <div class="w-full sm:w-64 lg:w-72 shrink-0 self-center lg:self-start">
        <div class="relative w-full aspect-[3/4] p-2 border border-outline/30 dark:border-dark-border bg-surface-container dark:bg-dark-card shadow-md">
          <img
            src="/images/yahya.png"
            alt="মুহাম্মদ ইয়াহিয়ার প্রতিকৃতি"
            class="w-full h-full object-cover filter grayscale hover:grayscale-0 transition-all duration-700"
            loading="eager"
          />
          <!-- Decorative Ink Corners -->
          <div class="absolute -bottom-3 -left-3 w-12 h-12 border-b-2 border-l-2 border-gold -z-10"></div>
          <div class="absolute -top-3 -right-3 w-12 h-12 border-t-2 border-r-2 border-gold -z-10"></div>
        </div>
      </div>
    </section>

    <!-- 2. TIMELINE SECTION (জীবনপঞ্জিকা) -->
    <section class="space-y-10 pt-8 border-t border-outline/20 dark:border-dark-border" aria-label="জীবনপঞ্জিকা">
      <div class="space-y-2">
        <h3 class="font-tiro text-2xl sm:text-3xl font-bold text-ink dark:text-dark-text">
          জীবনপঞ্জিকা ও ভূমিকা
        </h3>
        <p class="text-sm text-slate dark:text-dark-muted">
          উন্মুক্ত জ্ঞান আন্দোলন, প্রাতিষ্ঠানিক শিক্ষা ও নেতৃত্বের পথচলা
        </p>
      </div>

      <div class="relative pl-6 sm:pl-8 space-y-10 before:content-[''] before:absolute before:left-2 sm:before:left-3 before:top-2 before:bottom-2 before:w-[2px] before:bg-gold/40">
        {timeline.map((item) => (
          <div class="relative group space-y-2">
            <!-- Timeline Marker Dot -->
            <div class="absolute -left-[29px] sm:-left-[33px] top-1.5 w-4 h-4 rounded-none bg-paper dark:bg-dark-bg border-2 border-gold group-hover:bg-gold transition-colors duration-300"></div>
            
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-tiro text-lg font-bold text-secondary dark:text-gold">
                {item.period}
              </span>
              <span class="text-xs px-2.5 py-0.5 bg-surface-container dark:bg-dark-card border border-outline/20 dark:border-dark-border text-ink dark:text-dark-text font-semibold uppercase tracking-wider">
                {item.title}
              </span>
            </div>

            <p class="font-body text-sm sm:text-base text-slate dark:text-dark-muted leading-relaxed max-w-2xl">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. TOPICS & INTERESTS CHIPS -->
    <section class="space-y-6 pt-8 border-t border-outline/20 dark:border-dark-border" aria-label="দক্ষতা ও গবেষণার ক্ষেত্র">
      <h3 class="font-tiro text-xl font-bold text-ink dark:text-dark-text">
        দক্ষতা ও গবেষণার বিষয়সমূহ
      </h3>
      <div class="flex flex-wrap gap-2.5">
        {topics.map((topic) => (
          <span class="px-3.5 py-1.5 border border-outline/30 dark:border-dark-border bg-surface-container/50 dark:bg-dark-card text-slate dark:text-dark-muted font-body text-xs sm:text-sm uppercase tracking-wider hover:border-gold hover:text-gold transition-colors duration-200 cursor-default">
            {topic}
          </span>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
