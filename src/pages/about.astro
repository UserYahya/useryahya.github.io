---
import BaseLayout from '../layouts/BaseLayout.astro';

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Yahya",
  "alternateName": "মুহাম্মদ ইয়াহিয়া",
  "url": "https://yahya.bd/about",
  "image": "https://yahya.bd/images/yahya.png",
  "jobTitle": "Development Professional",
  "nationality": "Bangladeshi",
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
      "name": "Bangladesh University of Engineering and Technology (BUET)"
    }
  ],
  "description": "মুহাম্মদ ইয়াহিয়া একজন ডেভেলপমেন্ট প্রফেশনাল, যিনি প্রযুক্তি, উন্মুক্ত জ্ঞান, ডিজিটাল ট্রাস্ট অ্যান্ড সেফটি, কমিউনিটি ডেভেলপমেন্ট ও তথ্যভিত্তিক উদ্যোগের সংযোগস্থলে কাজ করেন।",
  "sameAs": [
    "https://meta.wikimedia.org/wiki/User:Yahya",
    "https://github.com/UserYahya"
  ],
  "knowsAbout": [
    "Open Knowledge",
    "Community Development",
    "Digital Trust & Safety",
    "Technology",
    "Data & Analytics",
    "Wikimedia Governance",
    "Wikidata & Structured Data",
    "Business Information Technology",
    "Mathematics",
    "Digital Policy",
    "Travel & Documentation"
  ]
};

const timeline = [
  {
    period: "২০২৫ — বর্তমান",
    title: "ডেভেলপমেন্ট, উন্মুক্ত জ্ঞান ও ডিজিটাল গভর্নেন্স",
    description: "উন্মুক্ত জ্ঞান ও প্রযুক্তিনির্ভর উদ্যোগের পাশাপাশি কমিউনিটি ডেভেলপমেন্ট, ডিজিটাল আস্থা ও নিরাপত্তা, ডিজিটাল নীতিমালা এবং অনলাইন প্ল্যাটফর্মের গভর্নেন্স নিয়ে কাজ করছি। আমার কাজের মূল লক্ষ্য হলো মানুষের অংশগ্রহণ বৃদ্ধি, তথ্যের নির্ভরযোগ্যতা নিশ্চিত করা এবং প্রযুক্তিকে আরও অর্থবহ ও অন্তর্ভুক্তিমূলক করে তোলা।"
  },
  {
    period: "২০২৩ — ২০২৫",
    title: "কমিউনিটি নির্মাণ ও প্রকল্প পরিচালনা",
    description: "ঢাকা উইকিমিডিয়া কমিউনিটির নেতৃত্ব, বিভিন্ন জ্ঞানভিত্তিক প্রতিযোগিতা ও প্রশিক্ষণ, ফটোগ্রাফি ও ডকুমেন্টেশন প্রকল্প এবং উইকি লাভস আর্থসহ নানা উদ্যোগে সংগঠক হিসেবে কাজ করেছি। স্বেচ্ছাসেবী দলকে একত্র করা, পারস্পরিক অংশীদারত্ব তৈরি এবং একটি ধারণাকে বাস্তব প্রকল্পে রূপ দেওয়া আমার এই সময়ের গুরুত্বপূর্ণ অর্জন।"
  },
  {
    period: "প্রযুক্তি ও সৃজনশীল উদ্যোগ",
    title: "ডিজিটাল টুল, ডেটা ও সমস্যা সমাধান",
    description: "সফটওয়্যার, অটোমেশন, ডেটা ও ওপেন-সোর্স প্রযুক্তি ব্যবহার করে বাস্তব সমস্যার সমাধান করতে আমি আগ্রহী। বট, ডেটা প্রসেসিং, তথ্যসংগ্রহ, কমিউনিটি টুল এবং ডিজিটাল ওয়ার্কফ্লো নিয়ে বিভিন্ন ছোট-বড় পরীক্ষামূলক প্রকল্পে কাজ করেছি। আমার কাছে প্রযুক্তি কেবল কোড নয়—এটি যেকোনো কাজকে সহজ, দ্রুত ও আরও অর্থবহ করার মাধ্যম।"
  },
  {
    period: "শিক্ষা ও চিন্তার ভিত্তি",
    title: "গণিত থেকে বিজনেস ইনফরমেশন টেকনোলজি",
    description: "গণিতে স্নাতক হওয়ার পর বাংলাদেশ প্রকৌশল বিশ্ববিদ্যালয় (বুয়েট) থেকে বিজনেস ইনফরমেশন টেকনোলজিতে পোস্ট গ্র্যাজুয়েট ডিপ্লোমা করছি। গাণিতিক যুক্তি, তথ্যপ্রযুক্তি ও বাস্তব ব্যবসায়িক সমস্যার সমন্বয় আমাকে বিশ্লেষণী চিন্তা থেকে প্রয়োগমুখী সমাধানের দিকে এগিয়ে দিয়েছে।"
  }
];

const topics = [
  "কমিউনিটি ডেভেলপমেন্ট",
  "উন্মুক্ত জ্ঞান",
  "ডিজিটাল ট্রাস্ট ও সেফটি",
  "প্রযুক্তি ও অটোমেশন",
  "ডেটা ও অ্যানালিটিক্স",
  "উইকিমিডিয়া ও ওপেন-সোর্স",
  "স্ট্রাকচার্ড ডেটা",
  "বিজনেস ইনফরমেশন টেকনোলজি",
  "ডিজিটাল পলিসি ও গভর্নেন্স",
  "গণিত ও বিশ্লেষণী চিন্তা",
  "ফটোগ্রাফি ও ডকুমেন্টেশন",
  "ভ্রমণ ও সাংস্কৃতিক অনুসন্ধান"
];
---

<BaseLayout
  title="আমার সম্পর্কে"
  description="মুহাম্মদ ইয়াহিয়ার পরিচিতি, অভিজ্ঞতা ও কাজের ক্ষেত্র—ডেভেলপমেন্ট, প্রযুক্তি, উন্মুক্ত জ্ঞান, কমিউনিটি ডেভেলপমেন্ট, ডেটা, ভ্রমণ ও ডিজিটাল গভর্নেন্সের সংযোগস্থলে একটি চলমান পথচলা।"
  activeNav="about"
  seo={{
    title: "আমার সম্পর্কে",
    description: "মুহাম্মদ ইয়াহিয়ার পরিচিতি, অভিজ্ঞতা ও কাজের ক্ষেত্র।",
    image: "/images/yahya.png",
    type: "profile",
    jsonLd: personJsonLd
  }}
>
  <div class="space-y-16 sm:space-y-20">
    <!-- 1. HERO BIO SECTION -->
    <section class="flex flex-col-reverse lg:flex-row gap-10 lg:gap-14 items-start">
      <!-- Bio Text -->
      <div class="flex-1 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-gold/15 dark:bg-gold/10 border border-gold/40 text-xs font-semibold text-secondary dark:text-gold uppercase tracking-widest">
          জীবন ও কর্ম
        </div>

        <h2 class="font-tiro text-3xl sm:text-4xl font-bold text-ink dark:text-dark-text leading-tight">
          আমি কী করি, কী নিয়ে ভাবি
        </h2>

        <div class="font-body text-base sm:text-lg text-slate dark:text-dark-muted space-y-4 leading-relaxed">
          <p>
            আমি <strong class="text-ink dark:text-gold font-semibold">মুহাম্মদ ইয়াহিয়া</strong>। একজন ডেভেলপমেন্ট প্রফেশনাল হিসেবে প্রযুক্তি, মানুষ, জ্ঞান ও কমিউনিটির সংযোগস্থলে কাজ করি। আমার আগ্রহের পরিসর কোনো একটি নির্দিষ্ট প্রতিষ্ঠান বা প্রযুক্তিতে সীমাবদ্ধ নয়; বরং কীভাবে মানুষকে সঙ্গে নিয়ে একটি ধারণাকে কার্যকর উদ্যোগে রূপ দেওয়া যায়, সেটিই আমাকে বেশি টানে।
          </p>

          <p>
            আমার কাজের একটি বড় অংশ জুড়ে আছে <strong class="text-ink dark:text-gold font-semibold">উন্মুক্ত জ্ঞান, কমিউনিটি ডেভেলপমেন্ট, ডিজিটাল আস্থা ও নিরাপত্তা, ডেটা ও প্রযুক্তি</strong>। পাশাপাশি প্রকল্প পরিকল্পনা, যোগাযোগ, প্রশিক্ষণ, স্বেচ্ছাসেবী নেতৃত্ব এবং বিভিন্ন মানুষের মধ্যে সহযোগিতার ক্ষেত্রেও কাজ করি। প্রযুক্তিকে আমি চূড়ান্ত লক্ষ্য হিসেবে দেখি না; বরং মানুষের সমস্যা বুঝে সঠিক সমাধান তৈরি করার একটি হাতিয়ার হিসেবে বিবেচনা করি।
          </p>

          <p>
            গণিত আমাকে যুক্তি, কাঠামো ও নির্ভুলতার মূল্য শিখিয়েছে; অন্যদিকে মাঠপর্যায়ের কমিউনিটির কাজ শিখিয়েছে—সব সমস্যার সমাধান কেবল পরিসংখ্যানে পাওয়া যায় না। তাই বিশ্লেষণী চিন্তার সঙ্গে মানুষের অভিজ্ঞতা, সংস্কৃতি ও বাস্তবতাকে মিলিয়ে দেখার চেষ্টা করি।
          </p>

          <blockquote class="pl-6 border-l-4 border-maroon dark:border-gold font-tiro text-lg sm:text-xl italic text-ink dark:text-gold my-6 py-1 bg-gold/5 dark:bg-gold/5">
            "জ্ঞান তখনই অর্থবহ হয়ে ওঠে, যখন তা মানুষের কাছে পৌঁছায়, মানুষ তাকে নিজের করে নেয় এবং সেই জ্ঞান থেকে নতুন কিছু তৈরি করতে পারে।"
          </blockquote>

          <p>
            কাজের বাইরে আমি ভ্রমণ, ফটোগ্রাফি, সংস্কৃতি ও স্থানীয় ইতিহাসের প্রতি আকৃষ্ট। একটি শহর বা দেশের গল্প আমার কাছে শুধু দর্শনীয় স্থানের তালিকা নয়—মানুষ, স্মৃতি, স্থাপত্য, পথঘাট এবং দৈনন্দিন জীবনের ছোট ছোট বিবরণও সেই গল্পের অবিচ্ছেদ্য অংশ। তাই লিখি, ছবি তুলি, নথিবদ্ধ করি এবং নতুন কিছু শেখার সন্ধানে নিয়মিত ঘুরে বেড়াই।
          </p>

          <p>
            আমার এই ওয়েবসাইটে কাজের পাশাপাশি থাকবে চিন্তা, শিক্ষা, প্রযুক্তি, ভ্রমণ, উন্মুক্ত জ্ঞান এবং পথে দেখা নানা মানুষের গল্প—যা নিছক একটি পেশাগত প্রোফাইলের চেয়েও একটু বেশি ব্যক্তিগত।
          </p>
        </div>

        <!-- Action CTAs -->
        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3 bg-gold hover:bg-maroon text-ink hover:text-paper dark:text-ink dark:hover:text-paper font-semibold text-xs sm:text-sm uppercase tracking-wider transition-colors duration-300 rounded-none shadow-sm"
          >
            যোগাযোগ করুন
          </a>
          <a
            href="https://meta.wikimedia.org/wiki/User:Yahya"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3 border-2 border-outline/40 dark:border-dark-border text-ink dark:text-dark-text hover:border-gold hover:text-secondary dark:hover:text-gold font-semibold text-xs sm:text-sm uppercase tracking-wider transition-colors duration-300 rounded-none"
          >
            উইকিমিডিয়া প্রোফাইল &rarr;
          </a>
        </div>
      </div>

      <!-- Tactile Photo Frame with Real Photo -->
      <div class="w-full sm:w-64 lg:w-72 shrink-0 self-center lg:self-start">
        <div class="relative w-full aspect-[3/4] p-2 border border-outline/30 dark:border-dark-border bg-surface-container dark:bg-dark-card shadow-md">
          <img
            src="/images/yahya.png"
            alt="মুহাম্মদ ইয়াহিয়ার প্রতিকৃতি"
            class="w-full h-full object-cover filter grayscale hover:grayscale-0 transition-all duration-700"
            loading="eager"
          />
          <!-- Decorative Ink Corners -->
          <div class="absolute -bottom-3 -left-3 w-12 h-12 border-b-2 border-l-2 border-gold -z-10"></div>
          <div class="absolute -top-3 -right-3 w-12 h-12 border-t-2 border-r-2 border-gold -z-10"></div>
        </div>
      </div>
    </section>

    <!-- 2. TIMELINE SECTION (জীবনপঞ্জিকা) -->
    <section class="space-y-10 pt-8 border-t border-outline/20 dark:border-dark-border" aria-label="জীবনপঞ্জিকা">
      <div class="space-y-2">
        <h3 class="font-tiro text-2xl sm:text-3xl font-bold text-ink dark:text-dark-text">
          পথচলা ও কাজের পরিসর
        </h3>
        <p class="text-sm text-slate dark:text-dark-muted">
          শিক্ষা, প্রযুক্তি, কমিউনিটি ও উন্মুক্ত জ্ঞানকে ঘিরে চলমান পথচলা
        </p>
      </div>

      <div class="relative pl-6 sm:pl-8 space-y-10 before:content-[''] before:absolute before:left-2 sm:before:left-3 before:top-2 before:bottom-2 before:w-[2px] before:bg-gold/40">
        {timeline.map((item) => (
          <div class="relative group space-y-2">
            <!-- Timeline Marker Dot -->
            <div class="absolute -left-[29px] sm:-left-[33px] top-1.5 w-4 h-4 rounded-none bg-paper dark:bg-dark-bg border-2 border-gold group-hover:bg-gold transition-colors duration-300"></div>
            
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-tiro text-lg font-bold text-secondary dark:text-gold">
                {item.period}
              </span>
              <span class="text-xs px-2.5 py-0.5 bg-surface-container dark:bg-dark-card border border-outline/20 dark:border-dark-border text-ink dark:text-dark-text font-semibold uppercase tracking-wider">
                {item.title}
              </span>
            </div>

            <p class="font-body text-sm sm:text-base text-slate dark:text-dark-muted leading-relaxed max-w-2xl">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. TOPICS & INTERESTS CHIPS -->
    <section class="space-y-6 pt-8 border-t border-outline/20 dark:border-dark-border" aria-label="দক্ষতা ও গবেষণার ক্ষেত্র">
      <h3 class="font-tiro text-xl font-bold text-ink dark:text-dark-text">
        যেসব বিষয় আমাকে টানে
      </h3>
      <div class="flex flex-wrap gap-2.5">
        {topics.map((topic) => (
          <span class="px-3.5 py-1.5 border border-outline/30 dark:border-dark-border bg-surface-container/50 dark:bg-dark-card text-slate dark:text-dark-muted font-body text-xs sm:text-sm uppercase tracking-wider hover:border-gold hover:text-gold transition-colors duration-200 cursor-default">
            {topic}
          </span>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>