---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JournalItem from '../components/JournalItem.astro';
import Newsletter from '../components/Newsletter.astro';
import { formatBanglaDate } from '../utils/date';

// Fetch and sort posts by publication date (descending)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts[0];
const olderPosts = sortedPosts.slice(1);
---

<BaseLayout
  title="মুহাম্মদ ইয়াহিয়া | উইকিমিডিয়া স্টুয়ার্ড ও ডেভেলপমেন্ট প্রফেশনাল"
  description="মুহাম্মদ ইয়াহিয়ার ব্যক্তিগত পোর্টফোলিও ও বাংলা ব্লগ। উইকিমিডিয়া স্টুয়ার্ড, ওপেন নলেজ গভর্নেন্স, প্রযুক্তি ও কমিউনিটি লিডারশিপের কথকতা।"
  activeNav="home"
>
  <div class="space-y-16 sm:space-y-24">
    <!-- 1. PROMINENT ABOUT ME HERO SECTION -->
    <section class="space-y-8 pb-10 border-b border-outline/20 dark:border-dark-border" aria-label="পরিচিতি">
      <div class="flex flex-col-reverse md:flex-row gap-8 items-start justify-between">
        <div class="space-y-6 flex-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-gold/15 dark:bg-gold/10 border border-gold/40 text-xs font-semibold text-secondary dark:text-gold uppercase tracking-widest">
            স্বাগতম
          </div>
          
          <h2 class="font-tiro text-3xl sm:text-4xl lg:text-5xl font-bold text-ink dark:text-dark-text leading-[1.3] text-balance">
            আমি ইয়াহিয়া। আমি একজন <span class="text-secondary dark:text-gold italic underline decoration-gold/40 underline-offset-8">উইকিমিডিয়া স্টুয়ার্ড</span> ও ডেভেলপমেন্ট প্রফেশনাল।
          </h2>

          <div class="space-y-3.5 pt-2 text-slate dark:text-dark-muted font-body text-base sm:text-lg">
            <p class="brush-bullet">উন্মুক্ত জ্ঞান (Open Knowledge), ডিজিটাল ট্রাস্ট অ্যান্ড সেফটি ও গ্লোবাল গভর্নেন্স নিয়ে কাজ করি</p>
            <p class="brush-bullet">বুয়েট (BUET) থেকে পোস্ট গ্র্যাজুয়েট ডিপ্লোমা ইন বিজনেস আইটি এবং গণিতে স্নাতক</p>
            <p class="brush-bullet">বাংলা উইকিকানেক্টের সহ-প্রতিষ্ঠাতা ও আন্তর্জাতিক উইকিমিডিয়া আন্দোলনের সক্রিয় সংগঠক</p>
          </div>

          <div class="pt-4 flex flex-wrap gap-4">
            <a
              href="/about"
              class="inline-flex items-center justify-center px-6 py-3 bg-gold hover:bg-maroon text-ink hover:text-paper dark:text-ink dark:hover:text-paper font-semibold text-xs sm:text-sm uppercase tracking-wider transition-colors duration-300 rounded-none shadow-sm"
            >
              আমার সম্পর্কে বিস্তারিত
            </a>
            <a
              href="/blog"
              class="inline-flex items-center justify-center px-6 py-3 border-2 border-outline/40 dark:border-dark-border text-ink dark:text-dark-text hover:border-gold hover:text-secondary dark:hover:text-gold font-semibold text-xs sm:text-sm uppercase tracking-wider transition-colors duration-300 rounded-none"
            >
              সব লেখাগুলো পড়ুন
            </a>
          </div>
        </div>

        <!-- Editorial Portrait Frame with Yahya's Real Photo -->
        <div class="w-36 h-36 sm:w-48 sm:h-48 md:w-52 md:h-52 shrink-0 relative self-center md:self-start">
          <div class="relative w-full h-full p-2 border border-outline/30 dark:border-dark-border bg-surface-container dark:bg-dark-card shadow-sm">
            <img
              src="/images/yahya.png"
              alt="মুহাম্মদ ইয়াহিয়ার প্রতিকৃতি"
              class="w-full h-full object-cover filter grayscale hover:grayscale-0 transition-all duration-700"
              loading="eager"
            />
            <!-- Decorative ink corners -->
            <div class="absolute -bottom-2 -left-2 w-6 h-6 border-b-2 border-l-2 border-gold -z-10"></div>
            <div class="absolute -top-2 -right-2 w-6 h-6 border-t-2 border-r-2 border-gold -z-10"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. LATEST / FEATURED JOURNAL ENTRY -->
    {featuredPost && (
      <section class="space-y-6" aria-label="সাম্প্রতিক লেখা">
        <div class="flex items-center justify-between border-b border-outline/20 dark:border-dark-border pb-3">
          <h3 class="font-tiro text-xl sm:text-2xl font-bold text-secondary dark:text-gold flex items-center gap-2">
            <span>সাম্প্রতিক লেখা</span>
          </h3>
          <a href="/blog" class="text-xs font-semibold text-slate dark:text-dark-muted hover:text-gold transition-colors">
            সব দেখুন &rarr;
          </a>
        </div>

        <article class="group cursor-pointer">
          <a href={`/blog/${featuredPost.slug}`} class="block space-y-6">
            {featuredPost.data.heroImage && (
              <div class="w-full h-64 sm:h-80 md:h-96 overflow-hidden bg-surface-container dark:bg-dark-card border border-outline/20 dark:border-dark-border">
                <img
                  src={featuredPost.data.heroImage}
                  alt={featuredPost.data.heroImageAlt || featuredPost.data.title}
                  loading="eager"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter grayscale-[15%] group-hover:grayscale-0"
                />
              </div>
            )}

            <div class="space-y-3 max-w-3xl">
              <div class="flex items-center gap-3 text-xs tracking-wider">
                <span class="text-secondary dark:text-gold font-semibold uppercase">{featuredPost.data.category}</span>
                <span class="w-1 h-1 bg-outline/40 rounded-full"></span>
                <time datetime={featuredPost.data.pubDate.toISOString()} class="text-slate dark:text-dark-muted">
                  {formatBanglaDate(featuredPost.data.pubDate)}
                </time>
                <span class="w-1 h-1 bg-outline/40 rounded-full"></span>
                <span class="text-slate dark:text-dark-muted">{featuredPost.data.readTime} পাঠ</span>
              </div>

              <h4 class="font-tiro text-2xl sm:text-3xl font-bold text-ink dark:text-dark-text group-hover:text-primary dark:group-hover:text-gold transition-colors duration-300 leading-snug">
                {featuredPost.data.title}
              </h4>

              <p class="font-body text-base text-slate dark:text-dark-muted line-clamp-3 leading-relaxed">
                {featuredPost.data.description}
              </p>
            </div>
          </a>
        </article>
      </section>
    )}

    <!-- 3. OLDER JOURNAL ENTRIES (JOURNAL INDEX FORMAT) -->
    {olderPosts.length > 0 && (
      <section class="space-y-6 pt-4" aria-label="পূর্ববর্তী লেখাগুলো">
        <h3 class="font-tiro text-xl sm:text-2xl font-bold text-ink dark:text-dark-text border-b-2 border-gold pb-3 inline-block">
          পূর্ববর্তী লেখাগুলো
        </h3>

        <div class="divide-y divide-transparent">
          {olderPosts.map((post) => (
            <JournalItem
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.slug}
              category={post.data.category}
              readTime={post.data.readTime}
              heroImage={post.data.heroImage}
              heroImageAlt={post.data.heroImageAlt}
            />
          ))}
        </div>
      </section>
    )}

    <!-- 4. NEWSLETTER / LETTER SUBSCRIPTION SECTION -->
    <Newsletter />
  </div>
</BaseLayout>
