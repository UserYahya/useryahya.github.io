---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatBanglaDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

// Fetch all posts to determine previous/next
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const formattedDate = formatBanglaDate(post.data.pubDate);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  activeNav="blog"
  seo={{
    title: post.data.title,
    description: post.data.description,
    image: post.data.heroImage,
    type: 'article',
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    tags: post.data.tags,
  }}
>
  <article class="w-full space-y-8">
    <!-- Post Header -->
    <header class="space-y-4 pb-6 border-b border-outline/15 dark:border-dark-border">
      <!-- Category Tag -->
      <div class="inline-block uppercase tracking-widest text-xs font-semibold text-secondary dark:text-gold border border-gold/40 px-3 py-1 bg-gold/10">
        {post.data.category}
      </div>

      <!-- Title -->
      <h1 class="font-tiro text-3xl sm:text-4xl lg:text-5xl font-bold text-ink dark:text-dark-text leading-[1.25] text-balance">
        {post.data.title}
      </h1>

      <!-- Meta Information -->
      <div class="flex items-center gap-3 text-xs sm:text-sm text-slate dark:text-dark-muted pt-2 tracking-wide">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        <span class="w-1 h-1 rounded-full bg-outline/40"></span>
        <span>{post.data.readTime} পাঠ</span>
        <span class="w-1 h-1 rounded-full bg-outline/40"></span>
        <span>লেখক: মুহাম্মদ ইয়াহিয়া</span>
      </div>
    </header>

    <!-- Hero Image -->
    {post.data.heroImage && (
      <div class="w-full h-64 sm:h-96 lg:h-[420px] overflow-hidden bg-surface-container dark:bg-dark-card border border-outline/20 dark:border-dark-border">
        <img
          src={post.data.heroImage}
          alt={post.data.heroImageAlt || post.data.title}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    )}

    <!-- Markdown Content Body -->
    <div class="prose prose-lg dark:prose-invert max-w-none text-slate dark:text-dark-muted font-body text-base sm:text-lg leading-bengali space-y-6 pt-4 bengali-drop-cap">
      <Content />
    </div>

    <!-- Article Tags -->
    {post.data.tags.length > 0 && (
      <div class="pt-8 border-t border-outline/15 dark:border-dark-border flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold text-slate dark:text-dark-muted mr-2">ট্যাগ:</span>
        {post.data.tags.map((tag) => (
          <span class="px-2.5 py-1 text-xs border border-outline/30 dark:border-dark-border text-slate dark:text-dark-muted uppercase tracking-wider bg-surface-container/40 dark:bg-dark-card">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Author Profile Snippet with Yahya's Real Photo and Role -->
    <div class="mt-12 p-6 sm:p-8 bg-surface-container/60 dark:bg-dark-card border border-outline/20 dark:border-dark-border flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
      <div class="w-20 h-20 rounded-full overflow-hidden shrink-0 border-2 border-gold p-0.5">
        <img
          src="/images/yahya.png"
          alt="মুহাম্মদ ইয়াহিয়া"
          class="w-full h-full object-cover rounded-full filter grayscale"
        />
      </div>
      <div class="space-y-2">
        <h4 class="font-tiro text-xl font-bold text-ink dark:text-gold">
          মুহাম্মদ ইয়াহিয়া
        </h4>
        <p class="font-body text-sm text-slate dark:text-dark-muted leading-relaxed">
          উইকিমিডিয়া স্টুয়ার্ড ও ডেভেলপমেন্ট প্রফেশনাল। উন্মুক্ত জ্ঞান আন্দোলন, প্রযুক্তি, ডিজিটাল গভর্নেন্স ও সম্প্রদায় নেতৃত্বে নিবেদিত।
        </p>
        <div class="pt-2">
          <a href="/about" class="text-xs font-semibold text-secondary dark:text-gold hover:underline">
            বিস্তারিত জানুন &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Previous / Next Navigation -->
    <nav class="pt-10 border-t border-outline/20 dark:border-dark-border grid grid-cols-1 sm:grid-cols-2 gap-6" aria-label="পূর্ববর্তী ও পরবর্তী পোস্ট">
      {prevPost ? (
        <a
          href={`/blog/${prevPost.slug}`}
          class="p-4 border border-outline/20 dark:border-dark-border hover:border-gold dark:hover:border-gold group transition-colors block text-left"
        >
          <span class="text-xs font-semibold text-slate dark:text-dark-muted uppercase tracking-wider flex items-center gap-1">
            &larr; পূর্ববর্তী লেখা
          </span>
          <span class="font-tiro text-base font-bold text-ink dark:text-dark-text group-hover:text-primary dark:group-hover:text-gold transition-colors line-clamp-1 mt-1 block">
            {prevPost.data.title}
          </span>
        </a>
      ) : <div />}

      {nextPost ? (
        <a
          href={`/blog/${nextPost.slug}`}
          class="p-4 border border-outline/20 dark:border-dark-border hover:border-gold dark:hover:border-gold group transition-colors block text-right"
        >
          <span class="text-xs font-semibold text-slate dark:text-dark-muted uppercase tracking-wider flex items-center justify-end gap-1">
            পরবর্তী লেখা &rarr;
          </span>
          <span class="font-tiro text-base font-bold text-ink dark:text-dark-text group-hover:text-primary dark:group-hover:text-gold transition-colors line-clamp-1 mt-1 block">
            {nextPost.data.title}
          </span>
        </a>
      ) : <div />}
    </nav>
  </article>
</BaseLayout>
